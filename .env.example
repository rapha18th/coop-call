# AssemblyAI: Voice Agent API, the voice of the coop
ASSEMBLYAI_API_KEY=

# Google Gemini: turns coop frames into events
GEMINI_API_KEY=

# Twilio: the phone number judges and owners dial, the SIP trunk to AssemblyAI,
# and outbound alarm calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Meta WhatsApp Cloud API: the existing Coop Call number
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Who the coop alerts, in E.164 format (+263..., +27...)
OWNER_PHONE=

# The coop phone, when it runs IP Webcam on the local network
NODE_URL=http://192.168.1.50:8080
NODE_USER=
NODE_PASSWORD=

# The Ziso API's public HTTPS address. AssemblyAI's HTTP tools only reach public hosts.
ZISO_PUBLIC_URL=
# Shared secret AssemblyAI sends in a header on every tool call
ZISO_TOOL_TOKEN=
