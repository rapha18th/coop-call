# AssemblyAI: Voice Agent API, the voice of the coop
ASSEMBLYAI_API_KEY=

# Google Gemini: turns coop frames into observations
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite

# Firebase (Firestore, Storage, Auth): path to a service account JSON file
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT=helenia-11f98
FIRESTORE_DATABASE=coop-call
STORAGE_BUCKET=helenia-11f98.firebasestorage.app

# Web Push, so the coop can ring the owner's phone. python scripts/vapid.py fills these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Where the web app lives, for CORS and pairing links
WEB_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173

# The public coop anyone can call from the landing page
DEMO_COOP_ID=demo
